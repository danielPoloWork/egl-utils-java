<?xml version="1.0" encoding="UTF-8"?>
<!-- d4np-concurrent -> d4np-core
     ADR-001 rule: arrows point toward core only, no cycles. Third-party dependencies arrive with
     the milestone item that needs them; maven-enforcer (item 1.7) will police the bans. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.d4np</groupId>
    <artifactId>d4np-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>d4np-concurrent</artifactId>
  <packaging>jar</packaging>

  <name>Concurrent</name>
  <description>Pooling and async execution. No third-party dependencies; DistributedLock is an interface here, never an implementation.</description>

  <properties>
    <!-- ITEM 5.1 / NFR-05. This is the first NFR in the project that mandates a jcstress harness BY
         NAME — "CustomThreadPoolFactory pools show 0 jcstress anomalies for rejection/shutdown
         races" — so the opt-in is a requirement rather than the judgement call it was for items
         3.1, 4.1 and 4.3, each of which recorded why a stateless type owes none. The parent
         defaults `jcstress.skip` to true and `consistency_lint.py`'s harness-opt-in check asserts
         this pairing in both directions, so this property and the harness under src/jcstress/java
         have to land together.

         No `jmh.skip` here: this module owns no src/bench/java yet. NFR-02's submission-overhead
         benchmark belongs to item 5.2, and RFC-0004 routes the GATE for it to item 8.3 rather than
         8.8, because 5 us is an ABSOLUTE bound where NFR-03's ratio was relative. -->
    <jcstress.skip>false</jcstress.skip>

    <!-- ITEM 5.2 / NFR-02. This module owns src/bench/java from here on, so it must opt in: the
         parent defaults `jmh.skip` to true and `-Pjmh` would otherwise COMPILE the benchmark and
         never run it — a harness that produces no number while the job reports success.
         `consistency_lint.py`'s harness-opt-in check asserts the pairing in both directions.

         The GATE for this budget is item 8.3's, not item 8.8's, and the distinction is RFC-0004's:
         NFR-03 is a RELATIVE ratio between two arms in one JMH invocation, so a slow runner slows
         both and the ratio holds; NFR-02 is phrased relatively but bounded ABSOLUTELY at 5 us, so a
         loaded runner moves the difference itself. Until 8.3 lands, the numbers are tracked on the
         reference machine and advisory in CI. -->
    <jmh.skip>false</jmh.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>it.d4np</groupId>
      <artifactId>d4np-core</artifactId>
    </dependency>
  </dependencies>

  <!-- ITEM 1.7 / ADR-001: spec §3 says "no third-party deps" for this module, so the allowlist is
       internal modules plus test scope. Default-deny.

       This rule is load-bearing for the family's shape, not just for this module: `DistributedLock`
       is an INTERFACE here and Redisson implements it in d4np-lock-redisson. The moment Redisson
       could be added here, that separation would be a convention instead of a structure — so this
       is the rule that keeps d4np-lock-redisson worth existing. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-adr-001</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>it.d4np:*</include>
                    <include>*:*:*:*:test</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
