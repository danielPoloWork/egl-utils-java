<?xml version="1.0" encoding="UTF-8"?>
<!-- d4np-test -> d4np-core
     ADR-001 rule: arrows point toward core only, no cycles. Third-party dependencies arrive with
     the milestone item that needs them; maven-enforcer (item 1.7) will police the bans. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.d4np</groupId>
    <artifactId>d4np-parent</artifactId>
    <version>0.0.0</version>
  </parent>

  <artifactId>d4np-test</artifactId>
  <packaging>jar</packaging>

  <name>Test support</name>
  <description>Test-scoped helpers. Production code importing this module fails the CI dependency check (FR-25).</description>

  <dependencies>
    <dependency>
      <groupId>it.d4np</groupId>
      <artifactId>d4np-core</artifactId>
    </dependency>
  </dependencies>

  <!-- ITEM 1.7 / ADR-001: spec §3 gives this module "test scope only" and no third-party of its own,
       so the allowlist is internal modules plus test scope. Default-deny.

       The complementary half of FR-25 — nobody may depend on THIS module from production code — is a
       rule about other modules, so it lives in the parent as a family-wide ban on
       `it.d4np:d4np-test` outside test scope. A module cannot enforce that about itself. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-adr-001</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>it.d4np:*</include>
                    <include>*:*:*:*:test</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
