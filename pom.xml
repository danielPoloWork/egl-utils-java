<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent POM for egl-utils-java — the nine-module reactor of ADR-001, established by ROADMAP
  item 1.1 and made normative by docs/adr/0003-maven-reactor-layout.md (supersedes ADR-0002).

  SCOPE OF ITEM 1.1: structure only. Plugin configuration (Spotless, ErrorProne, NullAway,
  Checkstyle) is item 1.4; maven-enforcer's banned-dependency rules are item 1.7; JaCoCo/PIT
  gates are item 8.2; japicmp is item 8.1. Third-party dependency versions arrive with the
  module that needs them, so dependencyManagement below pins ONLY the internal modules — a
  version pinned before a module uses it is speculation, and enforcer convergence (1.7) is
  what will police the rest.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>it.d4np</groupId>
  <artifactId>d4np-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>egl-utils-java (parent)</name>
  <description>Java Enterprise Architecture Library — a modular set of libraries implementing enterprise design patterns for Spring Boot and Jakarta EE systems.</description>
  <url>https://github.com/danielPoloWork/egl-utils-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>danielPoloWork</id>
      <name>Daniel Polo</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/danielPoloWork/egl-utils-java.git</connection>
    <developerConnection>scm:git:git@github.com:danielPoloWork/egl-utils-java.git</developerConnection>
    <url>https://github.com/danielPoloWork/egl-utils-java</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Spec §1.1: JDK 17 is the published baseline; 21 is exercised in CI. `release` pins the
         bytecode + API level so building on 21 cannot leak a 21-only symbol into a 17 artifact. -->
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Pinned explicitly, not left to inherit: the bytecode smoke test asserts major version 61,
         and that assertion is only sound if test classes are pinned to 17 as well. -->
    <maven.compiler.testRelease>17</maven.compiler.testRelease>

    <!-- Item 1.3. Versions resolved from Maven Central's latest STABLE release, never a milestone:
         ordering by timestamp returns pre-releases (junit-bom 5.13.0-M3, assertj 4.0.0-M1,
         surefire 3.6.0-M1 were all offered), and a library that promises binary compatibility
         must not pin an -M/-RC build. -->
    <junit.version>5.12.2</junit.version>
    <assertj.version>3.27.3</assertj.version>
    <!-- surefire MUST be pinned: Maven's default binding can be a 2.x surefire that does not know
         the JUnit Platform, so JUnit 5 tests are SILENTLY NOT RUN and the build still passes. That
         is the same vacuous-green class as the -Pjmh profile finding in item 1.2. -->
    <surefire.version>3.5.6</surefire.version>
    <compiler.plugin.version>3.15.0</compiler.plugin.version>

    <!-- Item 1.4 — quality toolchain. Latest STABLE, pre-releases filtered out. -->
    <spotless.plugin.version>2.44.5</spotless.plugin.version>
    <google.java.format.version>1.27.0</google.java.format.version>
    <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
    <checkstyle.version>10.26.1</checkstyle.version>
    <!-- Item 1.11 — ErrorProne + NullAway. The PAIR is the unit of choice, not two independent
         latest-stables: 2.50.0 + NullAway 0.12.7 was measured to fail with
         `ProvisionException: Failed to initialize com.uber.nullaway.NullAway`, because NullAway
         compiles against ErrorProne's internal check API and that API moves between releases.
         2.50.0 + 0.13.8 is the pair verified here. See docs/adr/0009 and the `errorprone` profile
         below for why it is JDK-21-activated. -->
    <errorprone.version>2.50.0</errorprone.version>
    <nullaway.version>0.13.8</nullaway.version>

    <!-- Item 1.7 — the ADR-001 dependency policy as a build gate (NFR-08). Latest stable. -->
    <enforcer.plugin.version>3.6.3</enforcer.plugin.version>

    <!-- Item 1.8 — the two NFR measurement harnesses of spec §6. Latest stable of each; JMH 1.37
         is also the floor the spec names ("JMH 1.37+"). -->
    <jmh.version>1.37</jmh.version>
    <jcstress.version>0.16</jcstress.version>
    <build.helper.plugin.version>3.6.0</build.helper.plugin.version>
    <exec.plugin.version>3.6.3</exec.plugin.version>

    <!-- HARNESS OPT-IN, per module. The `jmh`/`jcstress` profiles are inherited by all nine
         modules, but only a module that actually OWNS harness sources may run a harness: JMH exits
         non-zero on "No matching benchmarks" and jcstress on an empty test list, so an
         unconditional runner would fail the eight modules that have nothing to measure. A module
         opts in by overriding the switch to `false` in its own POM, next to the sources — and
         consistency_lint.py's `harness-opt-in` check asserts the two agree in both directions, so
         neither a silent skip nor an orphan switch can survive. -->
    <jmh.skip>true</jmh.skip>
    <jcstress.skip>true</jcstress.skip>

    <!-- PR-GRADE measurement settings, not publication-grade. One fork and one short iteration is
         enough to prove the harness runs end to end, which is all the CI `benchmark` and `jcstress`
         jobs are for; spec §6 asks for 5x10 warmup/measurement iterations on the named reference
         machine, and the numbers that back an NFR come from THAT run, overriding these on the
         command line (e.g. -Djmh.forks=5 -Djmh.iterations=10, -Djcstress.mode=default). Recording
         a CI number as an NFR result would be the mistake the manifest's own risk note already
         flags (orchestrator/project.yaml `risks`): GitHub-hosted runners vary in CPU model and
         steal time by far more than the NFR budgets do. -->
    <jmh.forks>1</jmh.forks>
    <jmh.warmup.iterations>1</jmh.warmup.iterations>
    <jmh.iterations>1</jmh.iterations>
    <jmh.time>1s</jmh.time>
    <jcstress.mode>sanity</jcstress.mode>
  </properties>

  <!-- ADR-001 dependency order: core first, then capability leaves, then adapters, then the BOM. -->
  <modules>
    <module>d4np-core</module>
    <module>d4np-jdbc</module>
    <module>d4np-concurrent</module>
    <module>d4np-security</module>
    <module>d4np-json</module>
    <module>d4np-spring-adapter</module>
    <module>d4np-lock-redisson</module>
    <module>d4np-test</module>
    <module>d4np-bom</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- The JUnit BOM governs every junit-* artifact from one version. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-jdbc</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-concurrent</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-security</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-json</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-spring-adapter</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-lock-redisson</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-test</artifactId><version>${project.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <!-- TEST SCOPE ONLY, so this does not violate ADR-001's zero-third-party-dependency rule for
       core: NFR-08 constrains compile/public surface, and test-scoped artifacts are not transitive
       to consumers. Declared on the parent so every module inherits one consistent test stack. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <!-- ITEM 1.11. AGENTS.md §9 and §10 have claimed "warnings-as-errors on the diff" since
                 the scaffold, and nothing enforced it. Declared HERE rather than in the `errorprone`
                 profile so all six build cells enforce it, including the three JDK-17 cells where
                 ErrorProne cannot run: a javac warning is a javac warning on either toolchain.
                 Verified clean on Temurin 17 and 21 with the harness profiles active before being
                 switched on, so it starts from a green tree rather than a suppression list. -->
            <showWarnings>true</showWarnings>
            <failOnWarning>true</failOnWarning>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.plugin.version}</version>
          <configuration>
            <java>
              <!-- ITEM 1.8: the include set is declared because Spotless's default covers ONLY
                   src/main/java and src/test/java. The harness roots src/bench/java and
                   src/jcstress/java hold committed Java that no profile is needed to read, so
                   without these four lines `spotless:check` would report a green format gate over
                   sources it never opened — and the harness code would be unformattable in
                   practice, since `spotless:apply` would not touch it either. Listing all four is
                   required: setting <includes> REPLACES the defaults rather than adding to them. -->
              <includes>
                <include>src/main/java/**/*.java</include>
                <include>src/test/java/**/*.java</include>
                <include>src/bench/java/**/*.java</include>
                <include>src/jcstress/java/**/*.java</include>
              </includes>
              <googleJavaFormat>
                <version>${google.java.format.version}</version>
              </googleJavaFormat>
              <removeUnusedImports/>
              <importOrder/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${checkstyle.plugin.version}</version>
          <configuration>
            <configLocation>config/checkstyle/checkstyle.xml</configLocation>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <!-- ITEM 1.8: stated explicitly because the default is ${project.testCompileSourceRoots},
                 and src/bench/java and src/jcstress/java only BECOME source roots when -Pjmh or
                 -Pjcstress is active — so the profile-less `mvn checkstyle:check` that CI's
                 format-lint job runs would never see them. A harness that fails the naming and
                 import rules the rest of the tree lives under is still a maintenance cost. A listed
                 directory that does not exist is skipped, so this works for the seven modules that
                 own no harness. -->
            <testSourceDirectories>
              <testSourceDirectory>${project.basedir}/src/test/java</testSourceDirectory>
              <testSourceDirectory>${project.basedir}/src/bench/java</testSourceDirectory>
              <testSourceDirectory>${project.basedir}/src/jcstress/java</testSourceDirectory>
            </testSourceDirectories>
            <consoleOutput>true</consoleOutput>
            <failsOnError>true</failsOnError>
            <violationSeverity>error</violationSeverity>
            <!-- Checkstyle 10.26.1 CANNOT PARSE a module declaration. Item 1.6 verified this is a
                 tool limitation and not a misconfiguration here: the pin is effective (the debug
                 log resolves checkstyle-10.26.1.jar), and the failure reproduces with a minimal
                 config of TreeWalker + AvoidStarImport on a bare `module m {}` —
                   IllegalStateException ... 1:0: no viable alternative at input 'module'
                 It is a hard failure of the whole goal, not a violation, so one module-info.java
                 would take the entire lint down. Excluding them costs nothing real: every rule in
                 checkstyle.xml is about naming, imports, structure or Javadoc of TYPE declarations,
                 and a module descriptor declares no types and has no imports (`requires` is not an
                 import, so IllegalImport could not police it either). Spotless DOES parse module
                 declarations, so formatting stays governed. -->
            <excludes>**/module-info.java</excludes>
          </configuration>
          <dependencies>
            <!-- Pin Checkstyle itself: the plugin ships an older engine, and the config above uses
                 rules whose behaviour changed across engine versions. -->
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <!-- ITEM 1.7 — maven-enforcer. These are the rules that hold for EVERY module. The
             framework-isolation half of ADR-001 is necessarily per-module (core may not see Jackson;
             d4np-json exists in order to see it), so each module declares its own
             `enforce-adr-001` execution. See docs/adr/0006 for why the split is that way round. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${enforcer.plugin.version}</version>
          <configuration>
            <rules>
              <!-- Spec §1.1 / NFR-07: 17 is the published baseline. Not an upper bound — 21 is
                   exercised in CI and must keep working. -->
              <requireJavaVersion>
                <version>[17,)</version>
              </requireJavaVersion>
              <!-- 3.3.1 is where Maven started reading .mvn/jvm.config, which this repo depends on
                   for google-java-format's jdk.compiler exports. A floor tied to a real requirement
                   rather than a guess at what CI runners happen to ship. -->
              <requireMavenVersion>
                <version>[3.3.1,)</version>
              </requireMavenVersion>
              <!-- NFR-12: a published library must never depend on a SNAPSHOT — it makes a release
                   unreproducible. The reactor's own version is a release version, not a snapshot. -->
              <requireReleaseDeps/>
              <banDuplicatePomDependencyVersions/>
              <!-- "Convergence rules" of item 1.7: transitive versions of the same artifact must
                   agree. Trivially satisfied today (no third-party dependencies exist) and the
                   reason it is wired now is that it stops being trivial the moment M2 adds one. -->
              <dependencyConvergence/>
              <bannedDependencies>
                <excludes>
                  <!-- FR-25: production code must not import the test module. `d4np-test` is legal
                       at TEST scope only; the include below is the exception to this ban. -->
                  <exclude>it.d4np:d4np-test</exclude>
                  <!-- Spec §1.1 / NFR-07: the jakarta.* namespace only, javax.* explicitly out of
                       scope. Checkstyle's IllegalImport catches a javax EE *import* in our own
                       sources; this catches the ARTIFACT entering the graph at all, including
                       transitively through a dependency nobody read. The two are complementary,
                       not redundant. Enumerated by EE groupId — JDK packages javax.crypto and
                       javax.sql ship in the JDK and have no artifact, so they cannot be caught
                       here by accident (FR-12 and FR-05 need them). -->
                  <exclude>javax.validation:*</exclude>
                  <exclude>javax.persistence:*</exclude>
                  <exclude>javax.servlet:*</exclude>
                  <exclude>javax.ws.rs:*</exclude>
                  <exclude>javax.inject:*</exclude>
                  <exclude>javax.transaction:*</exclude>
                  <exclude>javax.enterprise:*</exclude>
                  <exclude>javax.ejb:*</exclude>
                  <exclude>javax.jms:*</exclude>
                  <exclude>javax.annotation:*</exclude>
                  <exclude>javaee:*</exclude>
                  <exclude>javax:javaee-api</exclude>
                </excludes>
                <includes>
                  <!-- groupId:artifactId:version:type:scope — the test module at test scope only. -->
                  <include>it.d4np:d4np-test:*:*:test</include>
                </includes>
              </bannedDependencies>
            </rules>
          </configuration>
          <executions>
            <execution>
              <!-- Bound to `validate`, so the policy is checked by every ordinary build and fails
                   before anything is compiled. This execution carries no <rules> of its own, so it
                   inherits the plugin-level set above. -->
              <id>enforce-universal</id>
              <phase>validate</phase>
              <goals>
                <goal>enforce</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- Declared here, NOT only in pluginManagement: Maven resolves a goal prefix such as
         `spotless:check` from <build><plugins> and the default pluginGroups
         (org.apache.maven.plugins, org.codehaus.mojo). com.diffplug.spotless is in neither, so a
         management-only entry produces exactly the "No plugin found for prefix 'spotless'" failure
         the quality job already reported. Versions and configuration stay in pluginManagement above.

         No <executions> are bound on purpose: `mvn clean verify` stays a compile+test cycle, and the
         quality job invokes these goals explicitly, which is how ci.extra_jobs is written. -->
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
      <!-- Enforcer IS bound here (unlike Spotless and Checkstyle above), because a dependency-policy
           gate that only runs when someone remembers to invoke it is the review promise NFR-08 exists
           to replace. It runs at `validate`, costs no compilation, and every module inherits it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!-- ==========================================================================================
       ITEM 1.8 — the NFR measurement harnesses (spec §6, NFR-01..06).

       WHY THESE PROFILES EXIST AT ALL: `.github/workflows/ci.yml` has been invoking
       `mvn -B -Pjmh verify` (job `benchmark`) and `mvn -B -Pjcstress verify` (job `jcstress`)
       since the scaffold render, and NEITHER PROFILE EXISTED. Maven only WARNS on an unmatched
       profile — "The requested profile "jmh" could not be activated because it does not exist" —
       so both jobs ran an ordinary `verify` and reported a green performance and concurrency gate
       having measured neither. Same vacuous-green class as the unpinned surefire of item 1.3 and
       the `enforcer:enforce` CLI goal of item 1.7.

       WHY THE HARNESS SOURCES ARE COMPILED AS TEST-SCOPE ROOTS (ADR-0007): jmh-core and
       jcstress-core are third-party artifacts, and ADR-001/NFR-08 gives core, jdbc, concurrent and
       test a default-DENY allowlist. At compile scope they would each need an allowlist entry —
       i.e. the zero-third-party-dependency claim would be weakened to accommodate measurement
       tooling, and jmh-core would land in the consumer-visible graph. At TEST scope they are
       already permitted by the `*:*:*:*:test` wildcard every module carries, they are not
       transitive to consumers, and they cannot reach a published JAR. The harness code is
       verification code; test scope is where verification code belongs.
       ========================================================================================== -->
  <profiles>
    <!-- ITEM 1.11 — ErrorProne + NullAway, bound to compilation itself.

         SELF-ACTIVATING ON JDK 21+, and that is the whole design: ErrorProne 2.43.0 onward is
         compiled to class-file 65, so it cannot even load on the Temurin 17 cells (verified by
         reading the majors out of the published jars — 2.42.0 is the last release at class-file 61).
         An `<activation><jdk>` keeps the analysis automatic wherever it can run and inert where it
         cannot, instead of a `-P` flag every contributor and CI job must remember. The published
         baseline is unaffected: `release 17` still governs the bytecode in every cell.
         Consequence, stated rather than hidden: the three JDK-17 build cells compile WITHOUT this
         analysis. Three JDK-21 cells plus the `quality` job run it, and a compile-time checker's
         verdict does not depend on which JDK hosts it. -->
    <profile>
      <id>errorprone</id>
      <activation>
        <jdk>[21,)</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <!-- Plugin level, NOT per execution: main and test sources are both analysed, and
                   item 1.8's harness profiles append their own processor paths to this list from
                   their `default-testCompile` executions (combine.children="append"). -->
              <annotationProcessorPaths>
                <path>
                  <groupId>com.google.errorprone</groupId>
                  <artifactId>error_prone_core</artifactId>
                  <version>${errorprone.version}</version>
                </path>
                <path>
                  <groupId>com.uber.nullaway</groupId>
                  <artifactId>nullaway</artifactId>
                  <version>${nullaway.version}</version>
                </path>
              </annotationProcessorPaths>
              <compilerArgs>
                <!-- Both flags are REQUIREMENTS on JDK 21+, not tuning: ErrorProne names each one
                     in its own failure message when it is missing. `compilePolicy=simple` stops
                     javac from interleaving attribution and flow analysis, which ErrorProne's
                     matchers cannot survive; `should-stop=ifError=FLOW` keeps javac running to
                     the flow phase so NullAway's dataflow has something to read. -->
                <arg>-XDcompilePolicy=simple</arg>
                <arg>--should-stop=ifError=FLOW</arg>
                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                <!-- One argument, space-separated, as ErrorProne's javac plugin expects.
                     NullAway is promoted to ERROR because a nullability finding that only warns is
                     the review promise this replaces; AnnotatedPackages is what tells NullAway
                     which code it may assume is non-null by default. -->
                <arg>-Xplugin:ErrorProne -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=it.d4np -XepExcludedPaths:.*/target/generated-(test-)?sources/.*</arg>
              </compilerArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>jmh</id>
      <dependencies>
        <!-- TEST scope: see the ADR-0007 note above. jmh-core carries jopt-simple and commons-math3
             transitively; both are test-scope too, so dependencyConvergence is the only universal
             rule that sees them. -->
        <dependency>
          <groupId>org.openjdk.jmh</groupId>
          <artifactId>jmh-core</artifactId>
          <version>${jmh.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>${build.helper.plugin.version}</version>
            <executions>
              <execution>
                <id>add-bench-source</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/bench/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <executions>
              <execution>
                <!-- Maven's own id for the test-compile execution: naming it here MERGES this
                     configuration into that execution rather than adding a second one. -->
                <id>default-testCompile</id>
                <configuration>
                  <!-- JMH generates its runner classes and the META-INF/BenchmarkList resource from
                       @Benchmark via an annotation processor. combine.children="append" so that
                       -Pjmh,jcstress activates BOTH processors: without it the second profile's
                       list replaces the first's and one harness silently generates nothing. -->
                  <annotationProcessorPaths combine.children="append">
                    <path>
                      <groupId>org.openjdk.jmh</groupId>
                      <artifactId>jmh-generator-annprocess</artifactId>
                      <version>${jmh.version}</version>
                    </path>
                  </annotationProcessorPaths>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec.plugin.version}</version>
            <executions>
              <execution>
                <id>run-jmh</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <!-- CONFIGURATION LIVES IN THE EXECUTION, NOT AT PLUGIN LEVEL, and that is not
                     style: a plugin-level <configuration> is shared by every execution of that
                     plugin, and the `jcstress` profile below declares the SAME plugin. With both
                     profiles active (-Pjmh,jcstress) the two plugin-level blocks merge, one set of
                     <arguments> wins, and both executions run the same command — measured: jcstress
                     ran twice, JMH never ran, and the build still reported success. Per-execution
                     configuration is not shared, so the two compose. -->
                <configuration>
                  <!-- `exec` (a real child process), NOT `java` (in-process): JMH forks a JVM per
                       benchmark and builds that command line from java.class.path. Under exec:java
                       the benchmarks live in the plugin's isolated classloader, so the fork would
                       start a JVM that cannot see them. -Djmh.forks=0 would dodge that at the cost
                       of the isolation the measurement depends on. -->
                  <skip>${jmh.skip}</skip>
                  <executable>${java.home}/bin/java</executable>
                  <classpathScope>test</classpathScope>
                  <arguments>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>org.openjdk.jmh.Main</argument>
                    <argument>-f</argument>
                    <argument>${jmh.forks}</argument>
                    <argument>-wi</argument>
                    <argument>${jmh.warmup.iterations}</argument>
                    <argument>-i</argument>
                    <argument>${jmh.iterations}</argument>
                    <argument>-w</argument>
                    <argument>${jmh.time}</argument>
                    <argument>-r</argument>
                    <argument>${jmh.time}</argument>
                    <!-- Machine-readable results, so a future baseline comparison (item 8.3) has a
                         file to read instead of scraped console output. -->
                    <argument>-rf</argument>
                    <argument>json</argument>
                    <argument>-rff</argument>
                    <argument>${project.build.directory}/jmh-result.json</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>jcstress</id>
      <dependencies>
        <dependency>
          <groupId>org.openjdk.jcstress</groupId>
          <artifactId>jcstress-core</artifactId>
          <version>${jcstress.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>${build.helper.plugin.version}</version>
            <executions>
              <execution>
                <id>add-jcstress-source</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/jcstress/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <executions>
              <execution>
                <id>default-testCompile</id>
                <configuration>
                  <annotationProcessorPaths combine.children="append">
                    <path>
                      <groupId>org.openjdk.jcstress</groupId>
                      <artifactId>jcstress-core</artifactId>
                      <version>${jcstress.version}</version>
                    </path>
                  </annotationProcessorPaths>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec.plugin.version}</version>
            <executions>
              <execution>
                <id>run-jcstress</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <!-- Per-execution, for the reason spelled out in the `jmh` profile above: a
                     plugin-level block would be shared with `run-jmh` and the two would overwrite
                     each other under -Pjmh,jcstress. -->
                <configuration>
                  <!-- Same reason as JMH for `exec` over `java`, and stronger here: jcstress's whole
                       method is to fork JVMs and re-run each test under different scheduling and
                       different JIT stress flags, so it cannot work in-process. -->
                  <skip>${jcstress.skip}</skip>
                  <executable>${java.home}/bin/java</executable>
                  <classpathScope>test</classpathScope>
                  <!-- REQUIRED, and found by running it: jcstress writes its binary result blob
                       (jcstress-results-<timestamp>.bin.gz) to the process working directory and
                       offers NO option to redirect it — `-r` governs only the HTML report. With the
                       default working directory that is the module root, so every run dropped an
                       untracked artifact next to pom.xml, one `git add -A` away from being
                       committed. Pointing the process at target/ puts it where `mvn clean` can
                       reach it. Safe because <classpath/> expands to absolute paths. -->
                  <workingDirectory>${project.build.directory}</workingDirectory>
                  <arguments>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>org.openjdk.jcstress.Main</argument>
                    <argument>-m</argument>
                    <argument>${jcstress.mode}</argument>
                    <!-- ITEM 2.1. RESTORES A CAPABILITY jcstress SILENTLY LOSES HERE, and the loss
                         was self-inflicted by a class name the specification mandates.

                         jcstress probes the target VM for `@Contended` support ("Testing @Contended
                         works on all results and infra objects") and adds `-XX:-RestrictContended`
                         to the forked test VMs only if the probe exits 0. That probe is
                         `ContendedTestMain`, which calls `Reflections.getClasses("Result")` to find
                         its own result classes — and `Reflections` derives class names from
                         `java.class.path` by string-replacing path separators with dots. For a JAR
                         entry it reads `JarEntry.getName()` and gets a real name; for a DIRECTORY
                         entry it passes `File.toString()` straight through, so `target/classes`
                         yields `E:.repository.….it.d4np.utils.Result$Err` and `Class.forName` throws.
                         Anything whose path contains "Result" is enough — verified: FR-17's
                         `Result`/`Result$Ok`/`Result$Err` in target/classes AND `ResultTest` in
                         target/test-classes both match. Upstream never hits it because jcstress runs
                         its own suite from a shaded JAR.

                         Measured, not assumed: at v0.1.0 the probe printed `[OK]`; with item 2.1's
                         types it prints `[N/A]` plus an `Exception in thread "main"` stack trace, and
                         the forked VMs lose the flag — so `@Contended` padding stops taking effect,
                         false sharing between the result and state objects is no longer prevented,
                         and every jcstress test in this repo gets quietly LESS likely to observe the
                         interleaving it exists to forbid. A gate that weakens while staying green is
                         the exact failure class items 1.3, 1.7, 1.8 and 8.2 each recorded.

                         AND THE LOSS IS INVISIBLE IN THE LOG, which is why it is worth this much
                         comment. jcstress echoes only each configuration's *variable* flags in its
                         per-configuration `[OK] [flags]` lines; auto-detected global args are applied
                         without being printed. Diffing a v0.1.0 run against this one shows the SAME
                         two brackets (`[]` and `[Stress…]`) whether the probe passed or failed, so the
                         only signal is the `[N/A]` line itself. Supplied through `-jvmArgsPrepend` the
                         flag lands in each configuration's list instead, so it is now visible in the
                         log as well as in effect.

                         (This comment was itself rejected once by the XML parser: a comment may not
                         contain two consecutive dashes, so jcstress's own line prefix cannot be quoted
                         verbatim here. Third instance in this repo of a config format that will not
                         carry the comment explaining it, after `.mvn/jvm.config` and `.gitignore` in
                         item 1.4.)

                         `-jvmArgsPrepend` and not `-jvmArgs`: the latter "disables JVM flags
                         auto-detection, and runs only the single JVM mode" (its own help text), which
                         would collapse the 14-configuration matrix into one and cost far more
                         sensitivity than it restored. Prepend keeps auto-detection and simply puts
                         back the one flag the broken probe cannot.

                         Not made a property on purpose: this is a workaround for an upstream defect,
                         not a tuning knob, and a knob invites being blanked by someone who does not
                         know why it is here. `-XX:-RestrictContended` is diagnostic, hence the unlock
                         flag ahead of it; both are accepted by Temurin 17.0.20+8 and 21.0.12+8
                         (verified). If a future JDK removes `RestrictContended` — as it removed
                         `UseBiasedLocking`, which this same probe log still reports — every forked VM
                         will fail to start with `Unrecognized VM option`, loudly and by name. Drop
                         these two arguments then. -->
                    <argument>-jvmArgsPrepend</argument>
                    <argument>-XX:+UnlockDiagnosticVMOptions -XX:-RestrictContended</argument>
                    <argument>-r</argument>
                    <argument>${project.build.directory}/jcstress-results</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
