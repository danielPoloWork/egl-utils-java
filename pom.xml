<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent POM for egl-utils-java — the nine-module reactor of ADR-001, established by ROADMAP
  item 1.1 and made normative by docs/adr/0003-maven-reactor-layout.md (supersedes ADR-0002).

  SCOPE OF ITEM 1.1: structure only. Plugin configuration (Spotless, ErrorProne, NullAway,
  Checkstyle) is item 1.4; maven-enforcer's banned-dependency rules are item 1.7; JaCoCo/PIT
  gates are item 8.2; japicmp is item 8.1. Third-party dependency versions arrive with the
  module that needs them, so dependencyManagement below pins ONLY the internal modules — a
  version pinned before a module uses it is speculation, and enforcer convergence (1.7) is
  what will police the rest.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>it.d4np</groupId>
  <artifactId>d4np-parent</artifactId>
  <version>0.0.0</version>
  <packaging>pom</packaging>

  <name>egl-utils-java (parent)</name>
  <description>Java Enterprise Architecture Library — a modular set of libraries implementing enterprise design patterns for Spring Boot and Jakarta EE systems.</description>
  <url>https://github.com/danielPoloWork/egl-utils-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>danielPoloWork</id>
      <name>Daniel Polo</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/danielPoloWork/egl-utils-java.git</connection>
    <developerConnection>scm:git:git@github.com:danielPoloWork/egl-utils-java.git</developerConnection>
    <url>https://github.com/danielPoloWork/egl-utils-java</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Spec §1.1: JDK 17 is the published baseline; 21 is exercised in CI. `release` pins the
         bytecode + API level so building on 21 cannot leak a 21-only symbol into a 17 artifact. -->
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Pinned explicitly, not left to inherit: the bytecode smoke test asserts major version 61,
         and that assertion is only sound if test classes are pinned to 17 as well. -->
    <maven.compiler.testRelease>17</maven.compiler.testRelease>

    <!-- Item 1.3. Versions resolved from Maven Central's latest STABLE release, never a milestone:
         ordering by timestamp returns pre-releases (junit-bom 5.13.0-M3, assertj 4.0.0-M1,
         surefire 3.6.0-M1 were all offered), and a library that promises binary compatibility
         must not pin an -M/-RC build. -->
    <junit.version>5.12.2</junit.version>
    <assertj.version>3.27.3</assertj.version>
    <!-- surefire MUST be pinned: Maven's default binding can be a 2.x surefire that does not know
         the JUnit Platform, so JUnit 5 tests are SILENTLY NOT RUN and the build still passes. That
         is the same vacuous-green class as the -Pjmh profile finding in item 1.2. -->
    <surefire.version>3.5.6</surefire.version>
    <compiler.plugin.version>3.15.0</compiler.plugin.version>

    <!-- Item 1.4 — quality toolchain. Latest STABLE, pre-releases filtered out. -->
    <spotless.plugin.version>2.44.5</spotless.plugin.version>
    <google.java.format.version>1.27.0</google.java.format.version>
    <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
    <checkstyle.version>10.26.1</checkstyle.version>
    <!-- ErrorProne + NullAway are NOT configured here — see ROADMAP item 1.11. They need three
         JDK-21-specific javac flags and a compatible ErrorProne/NullAway version pair, and the
         latest stable of each (2.50.0 / 0.12.7) does not interoperate. Keeping them out leaves the
         build matrix green instead of trading four passing jobs for a static-analysis tool that is
         not yet wired. -->

    <!-- Item 1.7 — the ADR-001 dependency policy as a build gate (NFR-08). Latest stable. -->
    <enforcer.plugin.version>3.6.3</enforcer.plugin.version>
  </properties>

  <!-- ADR-001 dependency order: core first, then capability leaves, then adapters, then the BOM. -->
  <modules>
    <module>d4np-core</module>
    <module>d4np-jdbc</module>
    <module>d4np-concurrent</module>
    <module>d4np-security</module>
    <module>d4np-json</module>
    <module>d4np-spring-adapter</module>
    <module>d4np-lock-redisson</module>
    <module>d4np-test</module>
    <module>d4np-bom</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- The JUnit BOM governs every junit-* artifact from one version. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-jdbc</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-concurrent</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-security</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-json</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-spring-adapter</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-lock-redisson</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>it.d4np</groupId><artifactId>d4np-test</artifactId><version>${project.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <!-- TEST SCOPE ONLY, so this does not violate ADR-001's zero-third-party-dependency rule for
       core: NFR-08 constrains compile/public surface, and test-scoped artifacts are not transitive
       to consumers. Declared on the parent so every module inherits one consistent test stack. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
                </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.plugin.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>${google.java.format.version}</version>
              </googleJavaFormat>
              <removeUnusedImports/>
              <importOrder/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${checkstyle.plugin.version}</version>
          <configuration>
            <configLocation>config/checkstyle/checkstyle.xml</configLocation>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <consoleOutput>true</consoleOutput>
            <failsOnError>true</failsOnError>
            <violationSeverity>error</violationSeverity>
            <!-- Checkstyle 10.26.1 CANNOT PARSE a module declaration. Item 1.6 verified this is a
                 tool limitation and not a misconfiguration here: the pin is effective (the debug
                 log resolves checkstyle-10.26.1.jar), and the failure reproduces with a minimal
                 config of TreeWalker + AvoidStarImport on a bare `module m {}` —
                   IllegalStateException ... 1:0: no viable alternative at input 'module'
                 It is a hard failure of the whole goal, not a violation, so one module-info.java
                 would take the entire lint down. Excluding them costs nothing real: every rule in
                 checkstyle.xml is about naming, imports, structure or Javadoc of TYPE declarations,
                 and a module descriptor declares no types and has no imports (`requires` is not an
                 import, so IllegalImport could not police it either). Spotless DOES parse module
                 declarations, so formatting stays governed. -->
            <excludes>**/module-info.java</excludes>
          </configuration>
          <dependencies>
            <!-- Pin Checkstyle itself: the plugin ships an older engine, and the config above uses
                 rules whose behaviour changed across engine versions. -->
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <!-- ITEM 1.7 — maven-enforcer. These are the rules that hold for EVERY module. The
             framework-isolation half of ADR-001 is necessarily per-module (core may not see Jackson;
             d4np-json exists in order to see it), so each module declares its own
             `enforce-adr-001` execution. See docs/adr/0006 for why the split is that way round. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${enforcer.plugin.version}</version>
          <configuration>
            <rules>
              <!-- Spec §1.1 / NFR-07: 17 is the published baseline. Not an upper bound — 21 is
                   exercised in CI and must keep working. -->
              <requireJavaVersion>
                <version>[17,)</version>
              </requireJavaVersion>
              <!-- 3.3.1 is where Maven started reading .mvn/jvm.config, which this repo depends on
                   for google-java-format's jdk.compiler exports. A floor tied to a real requirement
                   rather than a guess at what CI runners happen to ship. -->
              <requireMavenVersion>
                <version>[3.3.1,)</version>
              </requireMavenVersion>
              <!-- NFR-12: a published library must never depend on a SNAPSHOT — it makes a release
                   unreproducible. The reactor's own 0.0.0 is a release version, not a snapshot. -->
              <requireReleaseDeps/>
              <banDuplicatePomDependencyVersions/>
              <!-- "Convergence rules" of item 1.7: transitive versions of the same artifact must
                   agree. Trivially satisfied today (no third-party dependencies exist) and the
                   reason it is wired now is that it stops being trivial the moment M2 adds one. -->
              <dependencyConvergence/>
              <bannedDependencies>
                <excludes>
                  <!-- FR-25: production code must not import the test module. `d4np-test` is legal
                       at TEST scope only; the include below is the exception to this ban. -->
                  <exclude>it.d4np:d4np-test</exclude>
                  <!-- Spec §1.1 / NFR-07: the jakarta.* namespace only, javax.* explicitly out of
                       scope. Checkstyle's IllegalImport catches a javax EE *import* in our own
                       sources; this catches the ARTIFACT entering the graph at all, including
                       transitively through a dependency nobody read. The two are complementary,
                       not redundant. Enumerated by EE groupId — JDK packages javax.crypto and
                       javax.sql ship in the JDK and have no artifact, so they cannot be caught
                       here by accident (FR-12 and FR-05 need them). -->
                  <exclude>javax.validation:*</exclude>
                  <exclude>javax.persistence:*</exclude>
                  <exclude>javax.servlet:*</exclude>
                  <exclude>javax.ws.rs:*</exclude>
                  <exclude>javax.inject:*</exclude>
                  <exclude>javax.transaction:*</exclude>
                  <exclude>javax.enterprise:*</exclude>
                  <exclude>javax.ejb:*</exclude>
                  <exclude>javax.jms:*</exclude>
                  <exclude>javax.annotation:*</exclude>
                  <exclude>javaee:*</exclude>
                  <exclude>javax:javaee-api</exclude>
                </excludes>
                <includes>
                  <!-- groupId:artifactId:version:type:scope — the test module at test scope only. -->
                  <include>it.d4np:d4np-test:*:*:test</include>
                </includes>
              </bannedDependencies>
            </rules>
          </configuration>
          <executions>
            <execution>
              <!-- Bound to `validate`, so the policy is checked by every ordinary build and fails
                   before anything is compiled. This execution carries no <rules> of its own, so it
                   inherits the plugin-level set above. -->
              <id>enforce-universal</id>
              <phase>validate</phase>
              <goals>
                <goal>enforce</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- Declared here, NOT only in pluginManagement: Maven resolves a goal prefix such as
         `spotless:check` from <build><plugins> and the default pluginGroups
         (org.apache.maven.plugins, org.codehaus.mojo). com.diffplug.spotless is in neither, so a
         management-only entry produces exactly the "No plugin found for prefix 'spotless'" failure
         the quality job already reported. Versions and configuration stay in pluginManagement above.

         No <executions> are bound on purpose: `mvn clean verify` stays a compile+test cycle, and the
         quality job invokes these goals explicitly, which is how ci.extra_jobs is written. -->
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
      <!-- Enforcer IS bound here (unlike Spotless and Checkstyle above), because a dependency-policy
           gate that only runs when someone remembers to invoke it is the review promise NFR-08 exists
           to replace. It runs at `validate`, costs no compilation, and every module inherits it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
