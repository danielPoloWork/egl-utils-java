<?xml version="1.0" encoding="UTF-8"?>
<!-- d4np-security -> d4np-core
     ADR-001 rule: arrows point toward core only, no cycles. Third-party dependencies arrive with
     the milestone item that needs them; maven-enforcer (item 1.7) will police the bans. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.d4np</groupId>
    <artifactId>d4np-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>d4np-security</artifactId>
  <packaging>jar</packaging>

  <name>Security</name>
  <description>JWT and cryptography under the ADR-003 hardened profiles. Owns its Nimbus JOSE+JWT surface.</description>

  <dependencies>
    <dependency>
      <groupId>it.d4np</groupId>
      <artifactId>d4np-core</artifactId>
    </dependency>
  </dependencies>

  <!-- ITEM 1.7 / ADR-001: spec §3 allows exactly one third-party family here — Nimbus JOSE+JWT, the
       JWT library ADR-003 chose. Default-deny, so Spring, Jackson and Redisson are excluded by the
       absence of an entry rather than by a ban that could be forgotten.

       The artifact is not declared yet; it arrives with FR-11 (item 6.1). The allowlist is written
       now anyway, because the alternative is discovering the policy at the moment you are trying to
       add a dependency. If Nimbus turns out to drag a transitive artifact of its own, the build will
       say so by name and extending this list is a deliberate, reviewed act — which is the intent. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-adr-001</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>it.d4np:*</include>
                    <include>*:*:*:*:test</include>
                    <include>com.nimbusds:*</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
