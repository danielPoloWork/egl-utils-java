<?xml version="1.0" encoding="UTF-8"?>
<!-- d4np-json -> d4np-core
     ADR-001 rule: arrows point toward core only, no cycles. Third-party dependencies arrive with
     the milestone item that needs them; maven-enforcer (item 1.7) will police the bans. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.d4np</groupId>
    <artifactId>d4np-parent</artifactId>
    <version>0.0.0</version>
  </parent>

  <artifactId>d4np-json</artifactId>
  <packaging>jar</packaging>

  <name>JSON</name>
  <description>Pre-configured Jackson with polymorphic default typing off. Keeps Jackson optional for core consumers.</description>

  <dependencies>
    <dependency>
      <groupId>it.d4np</groupId>
      <artifactId>d4np-core</artifactId>
    </dependency>
  </dependencies>

  <!-- ITEM 1.7 / ADR-001: this module exists so that Jackson is optional for everyone else, so
       Jackson is allowed here and nowhere upstream. Default-deny otherwise — in particular Spring
       stays out, because FR-20's JsonMapper must be usable without it.

       The `com.fasterxml.jackson*` prefix covers databind, annotations, core and the jsr310 datatype
       module in one entry; verified that enforcer matches a groupId prefix that way, so this does not
       silently miss `com.fasterxml.jackson.datatype`. Artifacts arrive with FR-20 (item 4.1). -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-adr-001</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>it.d4np:*</include>
                    <include>*:*:*:*:test</include>
                    <include>com.fasterxml.jackson*:*</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
