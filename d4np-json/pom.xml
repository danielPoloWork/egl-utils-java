<?xml version="1.0" encoding="UTF-8"?>
<!-- d4np-json -> d4np-core
     ADR-001 rule: arrows point toward core only, no cycles. Third-party dependencies arrive with
     the milestone item that needs them; maven-enforcer (item 1.7) will police the bans. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.d4np</groupId>
    <artifactId>d4np-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>d4np-json</artifactId>
  <packaging>jar</packaging>

  <name>JSON</name>
  <description>Pre-configured Jackson with polymorphic default typing off. Keeps Jackson optional for core consumers.</description>

  <properties>
    <!-- ITEM 4.1 / FR-20. Versions live HERE and not on the parent, per the parent's own rule:
         "third-party dependency versions arrive with the module that needs them". This module and
         d4np-spring-adapter are the only ones that may see Jackson at all (spec §3).

         2.22.1 — the LATEST STABLE 2.x — and the reasoning is the OPPOSITE WAY ROUND from item
         3.1's, because the scope is different. jakarta.validation-api is `provided`, so the HOST's
         copy wins at run time and ours has to be the floor of the compatibility matrix. Jackson is
         `compile`: ours is what a plain Jakarta EE / JDBC host actually resolves, so pinning an old
         release would ship that host an unpatched Jackson — the artifact with the longest CVE
         history in this dependency set, and the one NFR-11's scan exists to watch.

         The other half of the matrix is paid for by the CODE, not by the pin: a Spring Boot 3.2
         host's own BOM DOWNGRADES this to 2.15.3, so nothing here may use API newer than that.
         That is a claim, so it is measured rather than promised —

           mvn -B -pl d4np-json -am -Djackson.version=2.15.3 clean verify

         compiles and runs the whole suite against the floor. Item 4.2 inherits the obligation.
         Recorded in ROADMAP item 4.1 rather than left as folklore. -->
    <jackson.version>2.22.2</jackson.version>
  </properties>

  <!-- The BOM, not three pinned versions: Jackson's artifacts are released together but NOT always
       with the same version string (jackson-annotations has trailed databind's patch digit for
       whole minor lines), and the parent's `dependencyConvergence` rule fails the build on exactly
       that mismatch. Importing the BOM is what makes the pin above one number instead of a set that
       has to be kept in step by hand — the same reason the parent imports junit-bom. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>it.d4np</groupId>
      <artifactId>d4np-core</artifactId>
    </dependency>
    <!-- COMPILE scope, deliberately, and it is the first compile-scope third-party dependency in
         this repository. ADR-001 puts Jackson here precisely so that it is NOT optional for this
         module: `JsonMapper` has no meaning without a mapper to configure, and a `provided`-scope
         Jackson would recreate FR-14's absent-provider problem for a type whose entire job is to
         hold a configured object. Core stays at zero — that is what this module buys. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Declared rather than inherited by luck (item 3.1's Expressly precedent): FR-20 names the
         JavaTimeModule, and the datatype module is a separate artifact that databind does not pull
         in. Without it the registration below would not compile. -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
  </dependencies>

  <!-- ITEM 1.7 / ADR-001: this module exists so that Jackson is optional for everyone else, so
       Jackson is allowed here and nowhere upstream. Default-deny otherwise — in particular Spring
       stays out, because FR-20's JsonMapper must be usable without it.

       The `com.fasterxml.jackson*` prefix covers databind, annotations, core and the jsr310 datatype
       module in one entry; verified that enforcer matches a groupId prefix that way, so this does not
       silently miss `com.fasterxml.jackson.datatype`. Artifacts arrive with FR-20 (item 4.1). -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-adr-001</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>it.d4np:*</include>
                    <include>*:*:*:*:test</include>
                    <include>com.fasterxml.jackson*:*</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
