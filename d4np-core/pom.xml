<?xml version="1.0" encoding="UTF-8"?>
<!-- d4np-core (no internal dependencies — the root of the DAG)
     ADR-001 rule: arrows point toward core only, no cycles. Third-party dependencies arrive with
     the milestone item that needs them; maven-enforcer (item 1.7) will police the bans. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.d4np</groupId>
    <artifactId>d4np-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>d4np-core</artifactId>
  <packaging>jar</packaging>

  <name>Core</name>
  <description>Zero third-party dependencies: creational and structural patterns, the ADR-002 error model, validation, monitoring and conversion helpers.</description>

  <!-- ITEM 1.8 / ADR-0007: this module OWNS harness sources (src/bench/java, src/jcstress/java), so
       it opts the runners in. The parent defaults both switches to `true` (skip) because JMH and
       jcstress both exit non-zero when handed an empty test list, and the other eight modules have
       nothing to measure yet. The switch and the sources are checked against each other by
       consistency_lint.py's `harness-opt-in`, so a module cannot own benchmarks that never run —
       which is the defect this whole item exists to remove. Milestone 5 flips these in
       d4np-concurrent for NFR-02/NFR-05; nothing else is needed there. -->
  <properties>
    <jmh.skip>false</jmh.skip>
    <jcstress.skip>false</jcstress.skip>

    <!-- ITEM 3.1 / FR-14. Versions live HERE and not on the parent, per the parent's own rule:
         "third-party dependency versions arrive with the module that needs them". This module is
         the only one that may see Bean Validation at compile scope.

         3.0.2 rather than 3.1.x: spec §1.1 pins the compatibility matrix to Spring Boot 3.2+, whose
         managed Bean Validation is 3.0.2 with Hibernate Validator 8.0.x. A library that resolved a
         newer API than the host's would be the classic "works in our tests, NoSuchMethodError in
         production" shape — and at `provided` scope it is the HOST's copy that wins at run time,
         so ours must be the floor of the matrix rather than the newest release. -->
    <jakarta.validation.version>3.0.2</jakarta.validation.version>
    <hibernate.validator.version>8.0.2.Final</hibernate.validator.version>
    <expressly.version>5.0.0</expressly.version>
  </properties>

  <!-- ITEM 3.1: the provider is TEST scope, and it has to be. FR-14's contract — a rendered
       violation carries the property path and the message TEMPLATE, never the invalid value
       (C-01) — is a claim about what a real provider produces, so a hand-written stub would assert
       our own mock rather than the behaviour. Hibernate Validator is the reference implementation
       and Spring Boot's default, and at test scope it constrains neither the public surface nor a
       consumer's graph (NFR-08). Expressly is Hibernate Validator 8's Jakarta EL implementation:
       without one on the classpath the factory bootstraps into a warning and falls back, so it is
       declared rather than inherited by luck. -->
  <dependencies>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <version>${jakarta.validation.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <version>${hibernate.validator.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <version>${expressly.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- ITEM 1.7 / NFR-08: "core has ZERO third-party dependencies (jakarta.validation-api as
       provided)". Written as an ALLOWLIST (default-deny) rather than a list of banned frameworks,
       because the contract is "nothing", not "not Spring, Jackson or Redisson" — a ban list would
       have let commons-lang3 in. It is transitive, so it also catches a third-party artifact that
       arrives through something else rather than being declared here.

       Adding a compile dependency to this module therefore requires editing this allowlist, which
       is the point: it makes the zero-dependency claim a reviewed decision instead of a habit. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-adr-001</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <!-- Pattern is groupId:artifactId:version:type:scope. -->
                    <include>it.d4np:*</include>
                    <!-- TEST scope is out of scope for NFR-08 by design: test artifacts are not
                         transitive to consumers, so they constrain neither the public surface nor a
                         consumer's graph. Written as a scope wildcard rather than by enumerating
                         junit/assertj, so upgrading the test stack cannot break this module. -->
                    <include>*:*:*:*:test</include>
                    <!-- The one third-party artifact spec §3 permits here, and only as provided. -->
                    <include>jakarta.validation:jakarta.validation-api:*:*:provided</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
