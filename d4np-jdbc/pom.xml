<?xml version="1.0" encoding="UTF-8"?>
<!-- d4np-jdbc -> d4np-core
     ADR-001 rule: arrows point toward core only, no cycles. Third-party dependencies arrive with
     the milestone item that needs them; maven-enforcer (item 1.7) will police the bans. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.d4np</groupId>
    <artifactId>d4np-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>d4np-jdbc</artifactId>
  <packaging>jar</packaging>

  <name>JDBC</name>
  <description>Programmatic JDBC helpers — parameterized statements only, by construction. JDBC API only, no drivers.</description>

  <dependencies>
    <dependency>
      <groupId>it.d4np</groupId>
      <artifactId>d4np-core</artifactId>
    </dependency>
  </dependencies>

  <!-- ITEM 1.7 / ADR-001: spec §3 says "no driver deps — JDBC API only". The JDBC API ships in the
       JDK (java.sql), so it has no artifact, which makes this module's allowlist the same as core's
       minus the jakarta exemption: internal modules and test-scope artifacts, nothing else.
       Default-deny, because "JDBC API only" is a statement about everything, not about frameworks.
       A driver added for tests is legal at test scope — H2 for FR-05's suite is the expected case. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-adr-001</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>it.d4np:*</include>
                    <include>*:*:*:*:test</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
