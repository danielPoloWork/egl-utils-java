<?xml version="1.0" encoding="UTF-8"?>
<!-- d4np-jdbc -> d4np-core
     ADR-001 rule: arrows point toward core only, no cycles. Third-party dependencies arrive with
     the milestone item that needs them; maven-enforcer (item 1.7) will police the bans. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.d4np</groupId>
    <artifactId>d4np-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>d4np-jdbc</artifactId>
  <packaging>jar</packaging>

  <name>JDBC</name>
  <description>Programmatic JDBC helpers — parameterized statements only, by construction. JDBC API only, no drivers.</description>

  <properties>
    <!-- ITEM 4.3 / NFR-03. This module owns src/bench/java, so it must opt in: the parent defaults
         `jmh.skip` to true and `-Pjmh` would otherwise COMPILE the benchmark and never run it — a
         harness that produces no number while the job reports success. `consistency_lint.py`'s
         harness-opt-in check asserts this pairing in both directions. No `jcstress.skip` here: see
         SimpleJdbcExecutor's thread-safety section for why no concurrency harness is owed. -->
    <jmh.skip>false</jmh.skip>

    <!-- ITEM 4.4 / FR-06. `JdbcTxRunner` is the first type in this repository outside core with real
         per-thread state — the nesting detector — so it is the first here that spec §6's rule can
         bite on: a thread-safety claim without a named jcstress test is not a claim. Items 3.1, 4.1
         and 4.3 each recorded the opposite conclusion for a stateless type, which is what makes this
         opt-in a decision rather than a default. -->
    <jcstress.skip>false</jcstress.skip>

    <!-- H2 2.3.232, the LATEST stable, at TEST scope only (spec §3: "JDBC API only, no drivers").
         The reasoning is item 4.1's inverted once more, and the inversion is what makes it a
         decision rather than a copy: Jackson is pinned to the latest because at `compile` scope
         ours is what a consumer resolves; jakarta.validation is pinned to the matrix FLOOR because
         at `provided` scope the host's copy wins. A test-scope driver reaches no consumer at all,
         so neither argument applies and the only live consideration is NFR-11's scan, which reads
         test scope too — so: latest.

         Nothing in this module names an H2 type, and that is verified rather than intended. The
         tests reach H2 exclusively through `DriverManager` and a `jdbc:h2:mem:` URL, so the driver
         is discovered by the service loader and the compiler never sees it. A test that imported
         `org.h2.*` would compile, which is why the tests use a hand-written DataSource over
         DriverManager instead of H2's own JdbcDataSource. -->
    <h2.version>2.3.232</h2.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>it.d4np</groupId>
      <artifactId>d4np-core</artifactId>
    </dependency>
    <!-- The only third-party artifact this module has, and it is invisible to consumers: test
         scope, no `requires` on the descriptor, nothing on the compile classpath. FR-05's suite and
         NFR-03's benchmark both need a real database that starts in-process; H2 in-memory is the
         one the specification names. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- ITEM 1.7 / ADR-001: spec §3 says "no driver deps — JDBC API only". The JDBC API ships in the
       JDK (java.sql), so it has no artifact, which makes this module's allowlist the same as core's
       minus the jakarta exemption: internal modules and test-scope artifacts, nothing else.
       Default-deny, because "JDBC API only" is a statement about everything, not about frameworks.
       A driver added for tests is legal at test scope — H2 for FR-05's suite is the expected case. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-adr-001</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>it.d4np:*</include>
                    <include>*:*:*:*:test</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
