<?xml version="1.0" encoding="UTF-8"?>
<!-- d4np-spring-adapter -> d4np-core, d4np-json
     ADR-001 rule: arrows point toward core only, no cycles. Third-party dependencies arrive with
     the milestone item that needs them; maven-enforcer (item 1.7) will police the bans. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.d4np</groupId>
    <artifactId>d4np-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>d4np-spring-adapter</artifactId>
  <packaging>jar</packaging>

  <name>Spring adapter</name>
  <description>Confines Spring coupling to the edge: RFC 7807 problem+json mapping and the AOP/DI binding. Spring is `provided`, never transitive.</description>

  <dependencies>
    <dependency>
      <groupId>it.d4np</groupId>
      <artifactId>d4np-core</artifactId>
    </dependency>
    <dependency>
      <groupId>it.d4np</groupId>
      <artifactId>d4np-json</artifactId>
    </dependency>
  </dependencies>

  <!-- ITEM 1.7 / ADR-001. This is one of the two modules written as a BAN LIST rather than an
       allowlist, and the reason is transitive closure, not laziness.

       Spring Boot drags a large and version-dependent graph, and this module's job IS to depend on
       it. An allowlist would therefore have to enumerate Spring's own transitive closure and be
       re-enumerated on every Spring upgrade — turning an ADR-001 policy gate into a maintenance
       chore that fails for reasons unrelated to the policy. What ADR-001 actually claims about this
       module is narrower: Redisson has no business here, because distributed locking belongs to
       d4np-lock-redisson. That is precisely what is banned.

       Jackson is deliberately NOT banned: it arrives legitimately and transitively through
       d4np-json, which this module depends on by design (spec §3). -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-adr-001</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.redisson:*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
